#! General
# Canonical browser origin. English remains prefixless.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
GOOGLE_SITE_VERIFICATION=""

#! Database
# Supply a PostgreSQL connection string locally; never commit a real credential.
DATABASE_URL=""
ALLOW_V2_DEMO_SEED="false"
V2_DEMO_SEED_CONFIRMATION=""

#! Dashboard operator (one-shot; keep the allow flag false at rest)
# Set confirmation to grant-editor:<normalized-email>, run pnpm db:editor:upsert,
# then return the allow flag and confirmation to their defaults.
DASHBOARD_EDITOR_EMAIL="mucahidyazar@gmail.com"
ALLOW_DASHBOARD_EDITOR_UPSERT="false"
DASHBOARD_EDITOR_UPSERT_CONFIRMATION=""

#! Google Services
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=""
NEXT_PUBLIC_GOOGLE_TAG_MANAGER_ID=""

#! Auth.js
NEXTAUTH_URL="http://localhost:3000"
# Generate a unique 32+ character local value; do not reuse production secrets.
NEXTAUTH_SECRET=""
AUTH_TRUST_PROXY="false"

#! Garage Object Storage
MEDIA_S3_BUCKET="bekten-art-private-media"
MEDIA_S3_REGION="garage"
MEDIA_S3_ENDPOINT="https://s3.mucahid.dev"
MEDIA_S3_FORCE_PATH_STYLE="true"
MEDIA_S3_ACCESS_KEY_ID=""
MEDIA_S3_SECRET_ACCESS_KEY=""

#! Resend
RESEND_API_KEY=""
RESEND_FROM_EMAIL="support@mucahid.dev"
RESEND_REPLY_TO="support@mucahid.dev"
RESEND_WEBHOOK_SECRET=""
# Generate a unique 32+ character scheduler bearer secret.
OUTBOX_DISPATCH_SECRET=""

#! Apify
APIFY_TOKEN=""
APIFY_INSTAGRAM_USERNAME="bekten_usubaliev"
APIFY_ACTOR_ID="apify/instagram-api-scraper"
APIFY_RESULTS_LIMIT="60"
