FROM node:24-alpine AS base

ENV NEXT_TELEMETRY_DISABLED=1
ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH

RUN apk add --no-cache libc6-compat openssl \
  && corepack enable \
  && corepack prepare pnpm@11.21.0 --activate

WORKDIR /app

FROM base AS dependencies

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY prisma ./prisma
COPY prisma.config.ts ./prisma.config.ts
RUN pnpm install --frozen-lockfile

FROM base AS migration-runtime

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY scripts/migration-runtime/package.json ./scripts/migration-runtime/package.json
RUN pnpm --filter @bekten/migration-runtime deploy --prod /migration-runtime
COPY scripts/migration-runtime/prisma.config.ts /migration-runtime/prisma.config.ts

FROM base AS seed-runtime

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY scripts/seed-runtime/package.json ./scripts/seed-runtime/package.json
RUN pnpm --filter @bekten/seed-runtime deploy --prod /seed-runtime
COPY prisma /seed-runtime/prisma
RUN cd /seed-runtime && pnpm exec prisma generate --schema=prisma/schema.prisma

FROM base AS builder

ARG NEXT_PUBLIC_APP_URL=https://bekten.art
ARG NEXT_PUBLIC_GOOGLE_ANALYTICS_ID
ARG NEXT_PUBLIC_GOOGLE_TAG_MANAGER_ID

ENV NEXT_PUBLIC_APP_URL=$NEXT_PUBLIC_APP_URL
ENV NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=$NEXT_PUBLIC_GOOGLE_ANALYTICS_ID
ENV NEXT_PUBLIC_GOOGLE_TAG_MANAGER_ID=$NEXT_PUBLIC_GOOGLE_TAG_MANAGER_ID
ENV DATABASE_URL=postgresql://build:build@127.0.0.1:5432/build

COPY --from=dependencies /app/node_modules ./node_modules
COPY . .
RUN pnpm db:generate && pnpm build

FROM base AS runner

ARG PORT=3000

ENV HOSTNAME=0.0.0.0
ENV NODE_ENV=production
ENV PORT=$PORT

RUN addgroup --system --gid 1001 nodejs \
  && adduser --system --uid 1001 --ingroup nodejs nextjs

COPY --from=migration-runtime --chown=nextjs:nodejs /migration-runtime ./scripts/migration-runtime
COPY --from=builder --chown=nextjs:nodejs /app/.next/standalone ./
COPY --from=seed-runtime --chown=nextjs:nodejs /seed-runtime/node_modules ./node_modules
COPY --from=builder --chown=nextjs:nodejs /app/.next/static ./.next/static
COPY --from=builder --chown=nextjs:nodejs /app/public ./public
COPY --from=builder --chown=nextjs:nodejs /app/prisma ./prisma
COPY --from=builder --chown=nextjs:nodejs /app/scripts/start-production.mjs ./scripts/start-production.mjs
COPY --from=builder --chown=nextjs:nodejs /app/scripts/preflight-v2-cutover.mjs ./scripts/preflight-v2-cutover.mjs
COPY --from=builder --chown=nextjs:nodejs /app/scripts/seed-v2-demo.mjs ./scripts/seed-v2-demo.mjs
COPY --from=builder --chown=nextjs:nodejs /app/scripts/media-safety.mjs ./scripts/media-safety.mjs
COPY --from=builder --chown=nextjs:nodejs /app/scripts/lib ./scripts/lib

USER nextjs

EXPOSE $PORT

HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
  CMD wget -q -O /dev/null "http://127.0.0.1:${PORT}/api/ready" || exit 1

CMD ["node", "scripts/start-production.mjs"]
